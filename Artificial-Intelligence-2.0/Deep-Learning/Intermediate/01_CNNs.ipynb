    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize feature maps (activations) for a sample image\n",
    "layer_outputs = [layer.output for layer in cnn_model.layers[:3]]  # first 3 layers\n",
    "activation_model = keras.Model(inputs=cnn_model.input, outputs=layer_outputs)\n",
    "\n",
    "# Get feature maps for one test image\n",
    "sample_img = x_test[0:1]\n",
    "activations = activation_model.predict(sample_img)\n",
    "\n",
    "# Plot feature maps from first conv layer\n",
    "first_layer_activation = activations[0][0]  # (32, 32, 32)\n",
    "fig, axes = plt.subplots(4, 8, figsize=(12, 6))\n",
    "for i, ax in enumerate(axes.flat):\n",
    "    if i < 32:\n",
    "        ax.imshow(first_layer_activation[:, :, i], cmap='viridis')\n",
    "    ax.axis('off')\n",
    "plt.suptitle('Feature Maps After First Conv Layer')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Interview Problems\n",
    "\n",
    "### Problem 1: Build CNN for CIFAR-10 Classification\n",
    "\n",
    "Build a CNN with at least 3 conv blocks + data augmentation + dropout. Achieve >75% test accuracy. Plot training history.\n",
    "\n",
    "### Problem 2: Custom Data Augmentation Pipeline\n",
    "\n",
    "Implement a custom augmentation pipeline using `tf.image` functions (random flip, random brightness, random contrast, random crop) without using ImageDataGenerator. Demonstrate on sample images.\n",
    "\n",
    "### Problem 3: Calculate Output Shape\n",
    "\n",
    "Write a function that computes the output spatial dimensions after convolution and pooling: `out = floor((in + 2*pad - filter_size) / stride) + 1`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Solution: Problem 2 — Custom augmentation with tf.image\n",
    "def custom_augment(image, label):\n",
    "    image = tf.image.random_flip_left_right(image)\n",
    "    image = tf.image.random_brightness(image, max_delta=0.2)\n",
    "    image = tf.image.random_contrast(image, lower=0.8, upper=1.2)\n",
    "    image = tf.image.resize_with_crop_or_pad(image, 36, 36)\n",
    "    image = tf.image.random_crop(image, size=(32, 32, 3))\n",
    "    return image, label\n",
    "\n",
    "dataset = tf.data.Dataset.from_tensor_slices((x_train[:8], y_train[:8]))\n",
    "dataset = dataset.map(custom_augment)\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(12, 6))\n",
    "for i, (img, lbl) in enumerate(dataset.take(8)):\n",
    "    axes[i // 4][i % 4].imshow(img.numpy())\n",
    "    axes[i // 4][i % 4].axis('off')\n",
    "plt.suptitle('Custom Augmented Images')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Solution: Problem 3 — Output shape calculator\n",
    "def conv_output_shape(input_h, input_w, filter_h, filter_w, stride=1, padding='valid'):\n",
    "    if padding == 'same':\n",
    "        pad_h = filter_h // 2\n",
    "        pad_w = filter_w // 2\n",
    "        out_h = input_h // stride\n",
    "        out_w = input_w // stride\n",
    "    else:  # valid\n",
    "        pad_h = pad_w = 0\n",
    "        out_h = (input_h - filter_h) // stride + 1\n",
    "        out_w = (input_w - filter_w) // stride + 1\n",
    "    return (out_h, out_w)\n",
    "\n",
    "print(\"Conv(32, 32) with 3x3 filter, stride 1, same:\",\n",
    "      conv_output_shape(32, 32, 3, 3, 1, 'same'))\n",
    "print(\"Conv(32, 32) with 5x5 filter, stride 2, valid:\",\n",
    "      conv_output_shape(32, 32, 5, 5, 2, 'valid'))\n",
    "print(\"After MaxPool(2,2) on (16, 16):\",\n",
    "      conv_output_shape(16, 16, 2, 2, 2, 'valid'))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary\n",
    "\n",
    "- **Convolution** applies learned filters across input to detect features\n",
    "- **Padding** (valid/same) controls spatial size preservation\n",
    "- **Pooling** reduces dimensions and adds translation invariance\n",
    "- **CNN architecture** stacks Conv → Activation → Pooling → Dropout blocks\n",
    "- **Data augmentation** reduces overfitting via random transformations\n",
    "- **LeNet-5** established the foundational CNN pattern\n",
    "- **Feature map visualization** reveals what each layer detects"
   ]
  }
